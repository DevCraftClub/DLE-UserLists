<div id="user-lists-modal-{news-id}" class="user-lists-modal" title="{modal-title}" style="display:none" data-news-id="{news-id}">
	<input type="hidden" name="user_hash" value="{user-hash}">
	<div class="ul-lists-body" data-news-id="{news-id}"></div>
	<div class="ul-create mt-2">
		<input type="text" class="ul-new-name wide" placeholder="{create-label}" data-news-id="{news-id}">
		<button type="button" class="btn btn-sm btn-primary ul-create-btn" data-news-id="{news-id}">{create-label}</button>
	</div>
</div>
